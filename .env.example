# Neon panelinden alınan bağlantı adresini buraya yazmayın; gerçek değer
# yalnızca Windows ortam değişkeni olarak tanımlanmalıdır.
DATABASE_URL=postgresql://KULLANICI:SIFRE@HOST/veritabani?sslmode=require

# FastAPI ayrı bir servis olarak yayınlandığında Streamlit bu adresi kullanır.
API_URL=https://ornek-trex-api.onrender.com

# Ayarlanırsa veri uçları X-API-Key başlığı ister. Streamlit ve FastAPI'de aynı olmalıdır.
TREX_API_KEY=UZUN_RASTGELE_BIR_ANAHTAR

# Virgülle ayrılmış izinli arayüz adresleri; yerel geliştirmede * kullanılabilir.
API_CORS_ORIGINS=*

